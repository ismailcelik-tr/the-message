# Base build environment
FROM node:20-alpine AS base
WORKDIR /app

# Copy root and workspace package descriptions to leverage docker layer caching
COPY package.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/admin/package.json ./apps/admin/
COPY packages/shared/package.json ./packages/shared/
COPY scripts/ ./scripts/

# Install dependencies for all workspaces
RUN npm install

# Development Stage
# Used locally via docker-compose for hot-reloading development
FROM base AS development
COPY . .
EXPOSE 3000
CMD ["npm", "run", "api:dev"]

# Build Stage
# Transpiles TypeScript files into pure JS dist directories
FROM base AS build
COPY . .

# Vite inlines VITE_* values into the admin bundle at build time. .env files are
# excluded by .dockerignore, so they must arrive as build args (see fly.toml).
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN npm run shared:build
RUN npm run admin:build
RUN npm run api:build
# Prune development dependencies
RUN npm prune --omit=dev

# Production Stage
# Minimal image containing only production assets and runtimes
FROM node:20-alpine AS production
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/apps/admin/dist ./apps/admin/dist
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/

EXPOSE 3000
CMD ["node", "apps/api/dist/main.js"]
