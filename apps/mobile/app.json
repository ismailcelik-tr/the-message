{
  "expo": {
    "name": "Cagri",
    "slug": "cagri",
    "main": "index.js",
    "version": "1.0.1",
    "scheme": "cagri",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.themessage.cagri",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-fg.png",
        "backgroundColor": "#2A4B3D"
      },
      "minSdkVersion": 24,
      "versionCode": 21
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.themessage.cagri",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "Çağrı"
      },
      "buildNumber": "24"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2A4B3D",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "f732fcd2-cf13-4e9e-bf15-496da79cfb85"
      }
    },
    "owner": "ismailcelik"
  }
}
