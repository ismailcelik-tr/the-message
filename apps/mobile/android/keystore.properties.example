# Copy to keystore.properties and fill in your own values, then keep BOTH
# keystore.properties and app/release.keystore out of version control.
#
# Losing the keystore means Android will reject every future update of an
# already-installed app — back it up somewhere safe (password manager, encrypted drive).
#
# Generate one with:
#   keytool -genkeypair -v -keystore app/release.keystore -alias cagri-release \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# If this file is absent the release build falls back to debug signing.

storeFile=release.keystore
storePassword=<store-password>
keyAlias=cagri-release
keyPassword=<key-password>
