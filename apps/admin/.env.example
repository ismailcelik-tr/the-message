# Local development values for the admin panel (Vite inlines VITE_* at build time).
# In production these are supplied as Docker build args — see [build.args] in fly.toml.
VITE_API_URL=http://localhost:3000/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<key>
