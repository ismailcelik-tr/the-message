{
  "name": "the-message-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Çağrı (The Message) Monorepo - Islamic Guide Mobile App and API Backend",
  "workspaces": [
    "apps/api",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "api:build": "npm run build -w apps/api",
    "mobile:start": "npm run start -w apps/mobile",
    "ios": "npm run ios -w apps/mobile --",
    "shared:build": "npm run build -w packages/shared",
    "build": "npm run shared:build && npm run api:build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "expo": "^54"
  }
}
